# ./start-demo.sh creates .env with random local credentials on first run.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8088
POSTGRES_PASSWORD=replace-with-random-value
JWT_SECRET=replace-with-at-least-32-random-characters
DEMO_ADMIN_PASSWORD=replace-with-random-value
DEMO_CUSTOMER_PASSWORD=replace-with-random-value
